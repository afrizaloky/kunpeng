set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# Nested compiler checks must use the same compiler and Linux sysroot.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  ITRUSTEE_C_COMPILER ITRUSTEE_CXX_COMPILER ITRUSTEE_LINUX_SYSROOT)
set(ITRUSTEE_C_COMPILER "aarch64-linux-gnu-gcc" CACHE STRING "AArch64 Linux C compiler")
find_program(_itrustee_cc NAMES "${ITRUSTEE_C_COMPILER}" REQUIRED)
set(CMAKE_C_COMPILER "${_itrustee_cc}")
get_filename_component(_itrustee_compiler_dir "${_itrustee_cc}" DIRECTORY)
get_filename_component(_itrustee_compiler_name "${_itrustee_cc}" NAME)
string(REPLACE "gcc" "g++" _itrustee_cxx_name "${_itrustee_compiler_name}")
set(ITRUSTEE_CXX_COMPILER "${_itrustee_compiler_dir}/${_itrustee_cxx_name}"
  CACHE STRING "AArch64 Linux C++ compiler (defaults to g++ beside selected gcc)")
if(ITRUSTEE_CXX_COMPILER STREQUAL _itrustee_cc)
  message(FATAL_ERROR "Cannot infer C++ compiler; set ITRUSTEE_CXX_COMPILER explicitly")
endif()
find_program(_itrustee_cxx NAMES "${ITRUSTEE_CXX_COMPILER}" REQUIRED)
set(CMAKE_CXX_COMPILER "${_itrustee_cxx}")
set(ITRUSTEE_LINUX_SYSROOT "" CACHE PATH "Linux CA sysroot (not SDK musl)")
if(ITRUSTEE_LINUX_SYSROOT)
  set(CMAKE_SYSROOT "${ITRUSTEE_LINUX_SYSROOT}")
endif()
