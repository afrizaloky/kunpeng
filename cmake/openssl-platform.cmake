# iTrustee exposes no directory enumeration. Use upstream's explicit ENOSYS implementation.
file(READ "${SOURCE}/crypto/o_dir.c" text)
string(REPLACE "#if defined OPENSSL_SYS_UNIX || defined DJGPP" "#if 0 /* iTrustee has no directory IO */ || defined DJGPP" text "${text}")
file(WRITE "${SOURCE}/crypto/o_dir.c" "${text}")
file(READ "${SOURCE}/providers/implementations/rands/seeding/rand_unix.c" text)
string(REPLACE "#  ifdef DEVRANDOM_WAIT" "#  if defined(DEVRANDOM_WAIT) && !defined(OPENSSL_RAND_SEED_NONE)" text "${text}")
file(WRITE "${SOURCE}/providers/implementations/rands/seeding/rand_unix.c" "${text}")
file(READ "${SOURCE}/crypto/uid.c" text)
string(REPLACE "return getuid() != geteuid() || getgid() != getegid();" "return 1; /* TA has no inherited environment; never consult it. */" text "${text}")
file(WRITE "${SOURCE}/crypto/uid.c" "${text}")
file(READ "${SOURCE}/crypto/mem.c" text)
string(REPLACE "#if defined(_BSD_SOURCE) || (defined(_POSIX_C_SOURCE) && _POSIX_C_SOURCE >= 200112L)" "#if 0 /* Use upstream portable aligned allocation below. */" text "${text}")
string(REPLACE "#elif defined(_ISOC11_SOURCE)" "#elif 0" text "${text}")
file(WRITE "${SOURCE}/crypto/mem.c" "${text}")
