execute_process(COMMAND "${NM}" -D --undefined-only "${BINARY}" OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
file(GLOB_RECURSE headers "${SDK}/include/TA/*.h" "${SDK}/thirdparty/open_source/musl/libc/*.h")
set(declarations "")
foreach(header IN LISTS headers)
  file(READ "${header}" text)
  string(APPEND declarations "\n${text}")
endforeach()
string(REPLACE "\n" ";" lines "${imports}")
foreach(line IN LISTS lines)
  if(line MATCHES " U ([A-Za-z_][A-Za-z0-9_]*)$")
    set(symbol "${CMAKE_MATCH_1}")
    # Stack protector hooks are part of the SDK sample TA compiler contract.
    if(symbol MATCHES "^__stack_chk_(fail|guard)$")
      continue()
    endif()
    if(NOT declarations MATCHES "(^|[^A-Za-z0-9_])${symbol}[ \t\r\n]*\\(")
      message(FATAL_ERROR "TA import is not declared by SDK headers: ${symbol}")
    endif()
  endif()
endforeach()
message(STATUS "TA imports checked against SDK declarations; device export availability still requires loader validation")
